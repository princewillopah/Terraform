
### =========================================================================
### Basic for expression (list transformation)
### ========================================================================= 
### A for expression lets you loop over a list/map and build a new one.


### ------------------------------------------
### Square numbers - looping without filtering
### ------------------------------------------

variable "numbers" {
  default = [1, 2, 3, 4]
}

output "squares" {
  value = [for n in var.numbers : n * n]
}

### ------------------------------------------
### Filter while looping
### ------------------------------------------

output "evens" {
  value = [for n in var.numbers : n if n % 2 == 0]
}

